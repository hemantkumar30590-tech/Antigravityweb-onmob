    "agy-web": "bin/index.js"
  },
  "scripts": {
    "start": "node bin/index.js",
    "status": "node bin/index.js --status",
    "stop": "node bin/index.js --stop"
  },
  "keywords": [
    "antigravity",
    "antigravity-ide",
    "termux",
    "android",
    "mobile-browser",
    "web-gateway",
    "reverse-proxy"
